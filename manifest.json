{
  "manifest_version": 3,
  "name": "Session Cloner",
  "version": "2.0.0",
  "description": "Clone your browser session cookies into incognito or export for cross-browser transfer. Supports Twitter/X, Reddit, GitHub, Instagram, LinkedIn, Google, and custom sites.",
  "permissions": [
    "cookies",
    "tabs",
    "windows",
    "scripting",
    "storage",
    "contextMenus",
    "offscreen"
  ],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*"
  ],
  "optional_host_permissions": [
    "https://reddit.com/*",
    "https://www.reddit.com/*",
    "https://redd.it/*",
    "https://github.com/*",
    "https://gist.github.com/*",
    "https://instagram.com/*",
    "https://www.instagram.com/*",
    "https://linkedin.com/*",
    "https://www.linkedin.com/*",
    "https://google.com/*",
    "https://mail.google.com/*",
    "https://accounts.google.com/*",
    "https://discord.com/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
